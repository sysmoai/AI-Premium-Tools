# AI Premium Tools - pnpm Monorepo Configuration

# General
NODE_ENV=development
DEBUG=true

# Workspace Configuration
WORKSPACE_NAME=AI-Premium-Tools
WORKSPACE_VERSION=1.0.0

# Build Configuration
BUILD_TARGET=node
BUILD_FORMAT=esm

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aitools_db

# API Configuration
API_PORT=3000
API_HOST=localhost
API_BASE_URL=http://localhost:3000

# Authentication - required for admin authentication; do not commit real values.
AUTH_ENABLED=true
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=replace_with_a_strong_random_secret
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password

# Commerce safety gate - leave false until A0/A1/A2 approval and per-SKU
# provider eligibility are implemented and verified server-side.
COMMERCE_ENABLED=false

# Third-party Services
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
SENTRY_DSN=

# Cache
REDIS_URL=redis://localhost:6379

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
